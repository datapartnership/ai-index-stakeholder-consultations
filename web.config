<?xml version="1.0" encoding="utf-8"?>
<!-- Azure App Service (Windows/IIS) only: lets IIS serve the survey's .json data files. Ignored on Linux. -->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>
  </system.webServer>
</configuration>
